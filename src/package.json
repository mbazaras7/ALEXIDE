{
  "name": "src",
  "version": "1.0.0",
  "description": "All of your source code (and other program resources) should be placed in this sub-directory.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:backend",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test:backend",
    "test:backend": "cd backend && npm test",
    "db:up": "cd .. && docker-compose up --build",
    "db:down": "cd .. && docker-compose down",
    "db:reset": "cd .. && docker-compose down && docker volume rm backend_postgres_data && docker-compose up -d",
    "db:logs": "cd .. && docker-compose logs -f",
    "docker:smoke": "node scripts/docker-smoke-test.mjs",
    "docker:clean": "cd .. && docker-compose down -v && docker-compose build --no-cache",
    "setup": "npm install && cd src/backend && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
