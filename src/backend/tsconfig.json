{
  "compilerOptions": {
    "target": "ES2022", //Javascript language
    "module": "commonjs", //Module Code generation method
    "types": ["node", "jest"],
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"], //Which files to compile
  "exclude": ["node_modules", "dist", "src/docker/smokeTest.ts"] //Which files to ignore
}
